<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Thanh toán chuyển khoản</title>
  <style>
    body {
      font-family: -apple-system, "Segoe UI", Roboto, sans-serif;
      background: #f5f5f5;
      margin: 0;
      padding: 24px;
      display: flex;
      justify-content: center;
    }
    .card {
      background: #fff;
      border-radius: 12px;
      padding: 24px;
      max-width: 420px;
      width: 100%;
      text-align: center;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    }
    h2 {
      font-size: 18px;
      margin-bottom: 16px;
    }
    .qr-image {
      width: 100%;
      max-width: 340px;
      height: auto;
      border: 1px solid #eee;
      border-radius: 8px;
      margin-bottom: 16px;
    }
    .info {
      text-align: left;
      border-top: 1px solid #eee;
      padding-top: 12px;
      margin-bottom: 12px;
    }
    .row {
      display: flex;
      justify-content: space-between;
      padding: 6px 0;
      font-size: 14px;
    }
    .row span { color: #888; }
    .note {
      font-size: 13px;
      color: #d97706;
    }
  </style>
</head>

<body>
  <div class="card">
    <h2>Quét mã QR để thanh toán</h2>

    <img src="{{qrUrl}}" alt="QR code thanh toán" class="qr-image" />

    <div class="info">
      <div class="row"><span>Mã đơn hàng</span><strong>{{orderId}}</strong></div>
      {{!-- <div class="row"><span>Số tiền</span><strong>{{amount}} VNĐ</strong></div> --}}
      {{!-- <div class="row"><span>Nội dung CK</span><strong>{{paymentCode}}</strong></div> --}}
      {{!-- {{#if bankName}}
      <div class="row"><span>Ngân hàng</span><strong>{{bankName}}</strong></div>
      {{/if}}
      {{#if bankAccount}}
      <div class="row"><span>Số tài khoản</span><strong>{{bankAccount}}</strong></div>
      {{/if}} --}}
    </div>
  </div>
</body>

</html>